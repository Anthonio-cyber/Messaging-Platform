# ---------------------------------------------------------------------------
# Veylo - environment configuration
# Copy to .env and fill in. Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database ---------------------------------------------------------------
# Any PostgreSQL 14+ instance (Neon, Supabase, RDS, Render, self-hosted).
DATABASE_URL=postgres://veylo:veylo_dev_password@127.0.0.1:5432/veylo
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Secrets ----------------------------------------------------------------
# Generate each one separately:  openssl rand -base64 32
# AUTH_SECRET signs session tokens and blind indexes.
AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output
# DATA_ENCRYPTION_KEY encrypts recovery emails at rest (AES-256-GCM).
# Rotating this makes existing recovery addresses unreadable.
DATA_ENCRYPTION_KEY=replace-me-with-a-different-openssl-rand-base64-32

# --- URLs and identity ------------------------------------------------------
# Where the web app is served from.
APP_URL=http://localhost:5173
# Where this API is served from.
API_URL=http://localhost:4000
# The domain that user identities are minted under: username@IDENTITY_DOMAIN
IDENTITY_DOMAIN=veylo.chat
BRAND_NAME=Veylo
# Extra allowed browser origins, comma separated. APP_URL is always allowed.
CORS_ORIGINS=

# In production these become e.g.
#   APP_URL=https://app.veylo.chat
#   API_URL=https://api.veylo.chat
#   IDENTITY_DOMAIN=veylo.chat
#   COOKIE_DOMAIN=.veylo.chat

# --- Sessions and cookies ---------------------------------------------------
SESSION_TTL_HOURS=720
SESSION_IDLE_TIMEOUT_HOURS=168
# Leave blank unless the API and app are on different subdomains of one domain.
COOKIE_DOMAIN=
# MUST be true in production. The server refuses to boot otherwise.
COOKIE_SECURE=false
# Set true when running behind a load balancer / reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# --- File storage -----------------------------------------------------------
# "local" writes to disk (development only - not durable on most hosts).
# "s3" targets any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2, MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# --- Email (password reset, address verification, security alerts) ----------
# Leave blank in development: messages are printed to the server log instead.
# Example: smtps://apikey:SG.xxxx@smtp.sendgrid.net:465
SMTP_URL=
MAIL_FROM=Veylo <no-reply@veylo.chat>

# --- Calls ------------------------------------------------------------------
# One-to-one voice and video over WebRTC. Media is peer-to-peer and never reaches
# this server; only the signalling to set up a call passes through it.
CALLS_ENABLED=true
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relays media when a restrictive NAT blocks a direct path — roughly one
# connection in six. WITHOUT IT, THOSE CALLS SIMPLY FAIL TO CONNECT, so a real
# deployment needs one (Cloudflare Calls, Twilio, Xirsys, or self-hosted coturn).
# The relay only forwards encrypted packets it cannot read.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Operations -------------------------------------------------------------
# Comma-separated IPs exempt from rate limiting (health checkers, uptime probes).
RATE_LIMIT_TRUSTED_IPS=
# On first boot, the account with this identity is promoted to admin.
# Remove after the first administrator exists.
ADMIN_BOOTSTRAP_ADDRESS=
